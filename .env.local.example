# Copy this file to .env.local (already gitignored).
#
# This site shares its Supabase project with the arcade app
# (Class_app-web/web) so that the same admin login works in both places.
# Use the SAME values as Class_app-web/web/.env.local for the four
# Supabase/Anthropic vars below — do not create a second Supabase project.

# Public — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — used for AI-assisted content features.
ANTHROPIC_API_KEY=

# Server-only — a long random secret that authorizes POSTs to
# /api/admin/content (e.g. from the Hermes agent). Generate your own:
#   openssl rand -base64 32
ADMIN_API_SECRET=
