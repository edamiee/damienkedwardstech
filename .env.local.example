# Copy this file to .env.local (already gitignored).
#
# This site shares its Supabase project with the arcade app
# (Class_app-web/web) so that the same admin login works in both places.
# Use the SAME values as Class_app-web/web/.env.local for the four
# Supabase/Anthropic vars below — do not create a second Supabase project.

# Public — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — used for AI-assisted content features.
ANTHROPIC_API_KEY=

# Server-only — a long random secret that authorizes POSTs to
# /api/admin/content (e.g. from the Hermes agent). Generate your own:
#   openssl rand -base64 32
ADMIN_API_SECRET=

# Server-only — checked against the Authorization header Vercel Cron sends
# automatically when this var is set on the Vercel project. Generate your
# own the same way as ADMIN_API_SECRET; only needed for local testing of
# /api/cron/weekly-insight (Vercel provides its own copy in production).
CRON_SECRET=

# Server-only, optional — raises the GitHub API's unauthenticated 60/hr
# rate limit and allows the dev-log agent to read private repos. A
# classic PAT with public_repo (or repo, for private) scope is enough.
GITHUB_TOKEN=

# Server-only — the Telegram bot token from @BotFather for the admin-chat
# agent (see /api/telegram/webhook).
TELEGRAM_BOT_TOKEN=

# Server-only — your numeric Telegram chat id. Only messages from this
# chat get a reply/tool access; everyone else is silently ignored. Get
# yours by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_CHAT_ID=

# Server-only — a long random secret you also pass as secret_token when
# calling Telegram's setWebhook. Generate your own:
#   openssl rand -base64 32
TELEGRAM_WEBHOOK_SECRET=
